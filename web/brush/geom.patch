+#[wasm_bindgen]
+impl Training {
+    /// Expected depth (camera-space z, dataset units) and accumulated alpha of
+    /// the current splats seen from a pinhole camera, as interleaved
+    /// `[z, alpha]` per pixel, row-major. `rotation` is the camera-to-world
+    /// quaternion `[x, y, z, w]` (OpenCV axes: x right, y down, z forward),
+    /// `position` the camera centre. Resolves to `null` before any splats exist.
+    ///
+    /// Brush's own rasterizer does the compositing: each splat's depth is
+    /// rendered as a degree-0 SH colour, so `Σ wᵢ zᵢ` comes back in the red
+    /// channel and `Σ wᵢ` in alpha.
+    #[allow(clippy::too_many_arguments)]
+    #[wasm_bindgen(js_name = renderDepth)]
+    pub async fn render_depth(
+        &self,
+        position: Vec<f32>,
+        rotation: Vec<f32>,
+        fx: f32,
+        fy: f32,
+        cx: f32,
+        cy: f32,
+        width: u32,
+        height: u32,
+    ) -> Result<Option<js_sys::Float32Array>, JsValue> {
+        use brush_render::camera::{Camera, focal_to_fov};
+        use brush_render::kernels::camera_model::CameraModel;
+        use brush_render::{TextureMode, render_splats};
+        use burn::module::{Param, ParamId};
+        use burn::tensor::Tensor;
+
+        if position.len() != 3 || rotation.len() != 4 {
+            return Err(js_err_str("renderDepth: position needs 3 values and rotation 4"));
+        }
+        let Some(splats) = self.splat_view.latest() else {
+            return Ok(None);
+        };
+        let splats = splats.scaled(self.units_per_meter.get());
+        let pos = glam::Vec3::new(position[0], position[1], position[2]);
+        let rot = glam::Quat::from_xyzw(rotation[0], rotation[1], rotation[2], rotation[3]).normalize();
+        let forward = rot * glam::Vec3::Z;
+
+        let means = splats.means();
+        let device = means.device();
+        let n = means.dims()[0];
+        let p = Tensor::<1>::from_floats([pos.x, pos.y, pos.z], &device).reshape([1, 3]);
+        let f = Tensor::<1>::from_floats([forward.x, forward.y, forward.z], &device).reshape([3, 1]);
+        let z = (means - p).matmul(f); // [N, 1]
+        // Colours are clamped to ±100 and floored at 0 in the rasterizer:
+        // normalise the depth into that range and scale it back after.
+        let z_max = z
+            .clone()
+            .max()
+            .into_scalar_async::<f32>()
+            .await
+            .map_err(|e| js_err_str(&format!("{e:?}")))?;
+        let scale = (z_max / 50.0).max(1e-6);
+        const SH_C0: f32 = 0.282_094_8;
+        let feature = Tensor::cat(vec![z / scale, Tensor::zeros([n, 2], &device)], 1);
+        let dc = ((feature - 0.5) / SH_C0).reshape([n, 1, 3]);
+        let depth_splats = Splats {
+            transforms: splats.transforms.clone(),
+            sh_coeffs: Param::initialized(ParamId::new(), dc),
+            raw_opacities: splats.raw_opacities.clone(),
+            render_mip: splats.render_mip,
+            min_scale: splats.min_scale.clone(),
+        };
+        let camera = Camera::new(
+            pos,
+            rot,
+            focal_to_fov(fx as f64, width, &CameraModel::Pinhole),
+            focal_to_fov(fy as f64, height, &CameraModel::Pinhole),
+            glam::vec2(cx / width as f32, cy / height as f32),
+            CameraModel::Pinhole,
+        );
+        let (img, _) = render_splats(
+            depth_splats,
+            &camera,
+            glam::uvec2(width, height),
+            glam::Vec3::ZERO,
+            None,
+            TextureMode::Float,
+        )
+        .await;
+        let data = img
+            .into_data_async()
+            .await
+            .map_err(|e| js_err_str(&format!("{e:?}")))?
+            .try_into_vec::<f32>()
+            .map_err(|e| js_err_str(&format!("{e:?}")))?;
+        let mut out = vec![0f32; (width * height * 2) as usize];
+        for (px, o) in data.chunks_exact(4).zip(out.chunks_exact_mut(2)) {
+            let a = px[3];
+            o[0] = if a > 1e-4 { px[0] / a * scale } else { 0.0 };
+            o[1] = a;
+        }
+        Ok(Some(js_sys::Float32Array::from(out.as_slice())))
+    }
+}
