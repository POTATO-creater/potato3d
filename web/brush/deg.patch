+// The contribution kernel must predict, per splat, exactly how much the L1
+// (+ alpha-match) loss changes when that splat is removed and the view is
+// re-rendered.
+#[wasm_bindgen_test(unsupported = tokio::test)]
+async fn contribution_matches_removal() {
+    let cam = Camera::new(
+        glam::vec3(0.0, 0.0, -5.0),
+        glam::Quat::IDENTITY,
+        0.5,
+        0.5,
+        glam::vec2(0.5, 0.5),
+        CameraModel::Pinhole,
+    );
+    let img_size = glam::uvec2(64, 48);
+    let (w, h) = (img_size.x as usize, img_size.y as usize);
+    let device: burn::tensor::Device = brush_cube::test_helpers::test_device().await.into();
+    let bg = Vec3::new(0.2, 0.3, 0.1);
+    let alpha_weight = 0.5;
+
+    // GT: another scene on a zero background, so its RGB is premultiplied
+    // like the training GT.
+    let gt_scene = rng_scene(200, 1.0, (-3.0, -1.5), (-2.0, 1.0), 0xFACE);
+    let gt_px = render_scene(&gt_scene, &cam, img_size, &device).await;
+    let q = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u32;
+    let gt_packed: Vec<u32> = gt_px
+        .chunks_exact(4)
+        .map(|p| q(p[0]) | q(p[1]) << 8 | q(p[2]) << 16 | q(p[3]) << 24)
+        .collect();
+    let loss = |px: &[f32]| -> f32 {
+        px.chunks_exact(4)
+            .zip(&gt_packed)
+            .map(|(p, g)| {
+                let ch = |s: u32| ((g >> s) & 0xff) as f32 / 255.0;
+                let ga = ch(24);
+                let gt = [ch(0) + (1.0 - ga) * bg.x, ch(8) + (1.0 - ga) * bg.y, ch(16) + (1.0 - ga) * bg.z];
+                ((p[0] - gt[0]).abs() + (p[1] - gt[1]).abs() + (p[2] - gt[2]).abs()) / 3.0
+                    + alpha_weight * (p[3] - ga).abs()
+            })
+            .sum()
+    };
+    let render_bg = async |scene: &Scene| {
+        let splats = scene_to_splats(scene, &device);
+        let (out, _) = render_splats(splats, &cam, img_size, bg, None, TextureMode::Float).await;
+        read_finite(out).await
+    };
+
+    let scene = rng_scene(200, 1.0, (-3.0, -1.5), (-2.0, 1.0), 0xC0FFEE);
+    let splats = scene_to_splats(&scene, &device.clone().autodiff());
+    let out = crate::bwd::render_splats(splats, &cam, img_size, bg).await;
+    let gt_tensor = Tensor::<2, burn::tensor::Int>::from_data(
+        burn::tensor::TensorData::new(gt_packed.iter().map(|&v| v as i32).collect::<Vec<_>>(), [h, w]),
+        &device,
+    );
+    let contrib = crate::bwd::render_contribution(out.contribution, gt_tensor, alpha_weight, false)
+        .to_data_async()
+        .await
+        .expect("readback")
+        .try_into_vec::<f32>()
+        .expect("vec");
+    assert_eq!(contrib.len(), scene.len());
+
+    let full = loss(&render_bg(&scene).await);
+    // The 12 splats with the largest |contribution|, both signs.
+    let mut order: Vec<usize> = (0..scene.len()).collect();
+    order.sort_by(|&a, &b| contrib[b].abs().total_cmp(&contrib[a].abs()));
+    assert!(contrib[order[0]].abs() > 1.0, "the test scene should have splats that matter");
+    for &i in order.iter().take(12) {
+        let mut without = scene.clone();
+        without.raw_opacity[i] = -30.0;
+        let actual = loss(&render_bg(&without).await) - full;
+        let predicted = contrib[i];
+        assert!(
+            (actual - predicted).abs() <= 2e-3 + 0.01 * actual.abs(),
+            "splat {i}: removal changed the loss by {actual}, kernel predicted {predicted}",
+        );
+    }
+    assert!(
+        order.iter().take(12).any(|&i| contrib[i] < 0.0),
+        "a random scene against a random GT should have harmful splats among the checked ones",
+    );
+}
