+/// Launches [`kernels::rasterize_backwards::contribution_kernel`]: dense
+/// `[num_points]` per-splat L1 contribution for one rendered view.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn contribution_cube(
+    out_img: FloatTensor<CubeBackend>,
+    projected_splats: FloatTensor<CubeBackend>,
+    compact_gid_from_isect: IntTensor<CubeBackend>,
+    tile_offsets: IntTensor<CubeBackend>,
+    global_from_compact_gid: IntTensor<CubeBackend>,
+    gt_packed: IntTensor<CubeBackend>,
+    background: Vec3,
+    img_size: glam::UVec2,
+    num_points: usize,
+    alpha_weight: f32,
+    mask_by_gt_alpha: bool,
+) -> FloatTensor<CubeBackend> {
+    let _span = tracing::trace_span!("contribution").entered();
+    let device = out_img.device.clone();
+    let client = projected_splats.client.clone();
+    let contrib = CubeBackend::float_zeros([num_points.max(1)].into(), &device, FloatDType::F32);
+    if projected_splats.shape()[0] == 0 {
+        return contrib;
+    }
+    let gt_packed = into_contiguous(gt_packed);
+
+    let tile_bounds = uvec2(
+        img_size.x.div_ceil(crate::shaders::helpers::TILE_WIDTH),
+        img_size.y.div_ceil(crate::shaders::helpers::TILE_WIDTH),
+    );
+    let hard_floats = client
+        .properties()
+        .atomic_type_usage(Type::atomic(Type::new(ElemType::Float(FloatKind::F32))))
+        .contains(AtomicUsage::Add);
+    let cube_count = CubeCount::Static(tile_bounds.x, tile_bounds.y, 1);
+    let cube_dim = CubeDim::new_1d(kernels::rasterize_backwards::SPLAT_BATCH);
+    let uniforms = RasterizeUniformsLaunch::new(
+        tile_bounds.x,
+        img_size.x,
+        img_size.y,
+        background.x,
+        background.y,
+        background.z,
+    );
+    let mask = u32::from(mask_by_gt_alpha);
+
+    use kernels::rasterize_backwards::{CasAtomicAdd, HfAtomicAdd, contribution_kernel};
+    if hard_floats {
+        contribution_kernel::launch::<HfAtomicAdd>(
+            &client,
+            cube_count,
+            cube_dim,
+            compact_gid_from_isect.into_tensor_arg(),
+            tile_offsets.into_tensor_arg(),
+            projected_splats.into_tensor_arg(),
+            out_img.into_tensor_arg(),
+            gt_packed.into_tensor_arg(),
+            global_from_compact_gid.into_tensor_arg(),
+            contrib.clone().into_tensor_arg(),
+            uniforms,
+            alpha_weight,
+            mask,
+        );
+    } else {
+        contribution_kernel::launch::<CasAtomicAdd>(
+            &client,
+            cube_count,
+            cube_dim,
+            compact_gid_from_isect.into_tensor_arg(),
+            tile_offsets.into_tensor_arg(),
+            projected_splats.into_tensor_arg(),
+            out_img.into_tensor_arg(),
+            gt_packed.into_tensor_arg(),
+            global_from_compact_gid.into_tensor_arg(),
+            contrib.clone().into_tensor_arg(),
+            uniforms,
+            alpha_weight,
+            mask,
+        );
+    }
+    contrib
+}
