+// ---------------------------------------------------------------------------
+// Render-loss contribution: a non-differentiable side pass over one forward
+// render (see `contribution_kernel`).
+// ---------------------------------------------------------------------------
+
+/// What the contribution pass needs from one forward render, on the inner
+/// (non-autodiff) backend.
+#[derive(Clone, Debug)]
+pub struct ContributionInputs {
+    out_img: FloatTensor<brush_cube::MainBackend>,
+    projected_splats: FloatTensor<brush_cube::MainBackend>,
+    compact_gid_from_isect: IntTensor<brush_cube::MainBackend>,
+    tile_offsets: IntTensor<brush_cube::MainBackend>,
+    global_from_compact_gid: IntTensor<brush_cube::MainBackend>,
+    background: Vec3,
+    img_size: glam::UVec2,
+    num_points: usize,
+}
+
+fn inner_kind(t: burn::backend::DispatchTensor) -> burn::backend::DispatchTensorKind {
+    match t.kind {
+        burn::backend::DispatchTensorKind::Autodiff(inner) => *inner,
+        other => other,
+    }
+}
+
+fn inner_float(t: burn::backend::DispatchTensor) -> FloatTensor<brush_cube::MainBackend> {
+    match inner_kind(t) {
+        crate::backend_kind!(burn::backend::BackendTensor::Autodiff(t)) => t.primitive,
+        crate::backend_kind!(bt) => bt.float(),
+        _ => panic!("contribution: expected a Wgpu float tensor"),
+    }
+}
+
+fn inner_int(t: burn::backend::DispatchTensor) -> IntTensor<brush_cube::MainBackend> {
+    match inner_kind(t) {
+        crate::backend_kind!(bt) => bt.int(),
+        _ => panic!("contribution: expected a Wgpu int tensor"),
+    }
+}
+
+/// Per-splat L1 render-loss contribution of one view, dense `[num_points]`
+/// on the inner backend: how much the loss would grow without each splat
+/// (negative = removing it helps). `gt_packed` is the same packed GT the
+/// loss sees; `alpha_weight` mirrors the alpha-match weight (0 when off).
+pub fn render_contribution(
+    inputs: ContributionInputs,
+    gt_packed: Tensor<2, burn::tensor::Int>,
+    alpha_weight: f32,
+    mask_by_gt_alpha: bool,
+) -> Tensor<1> {
+    let gt = crate::burn_glue::unwrap_wgpu_int(gt_packed);
+    let client = inputs.out_img.client.clone();
+    let float = |t| client.clone().resolve_tensor_float::<CubeBackend>(t);
+    let int = |t| client.clone().resolve_tensor_int::<CubeBackend>(t);
+    let contrib = super::render_bwd::contribution_cube(
+        float(inputs.out_img),
+        float(inputs.projected_splats),
+        int(inputs.compact_gid_from_isect),
+        int(inputs.tile_offsets),
+        int(inputs.global_from_compact_gid),
+        int(gt),
+        inputs.background,
+        inputs.img_size,
+        inputs.num_points,
+        alpha_weight,
+        mask_by_gt_alpha,
+    );
+
+    // Bind the eagerly computed result back into the fusion stream.
+    #[derive(Debug)]
+    struct BindOp {
+        desc: CustomOpIr,
+        contrib: FloatTensor<CubeBackend>,
+    }
+    impl Operation<FusionCubeRuntime> for BindOp {
+        fn execute(
+            &self,
+            h: &mut HandleContainer<FusionHandle<FusionCubeRuntime>>,
+        ) -> Result<(), ExecutionError> {
+            let (_, [out]) = self.desc.as_fixed::<0, 1>();
+            h.register_float_tensor::<CubeBackend>(&out.id, self.contrib.clone());
+            Ok(())
+        }
+    }
+    let out_ir = TensorIr::uninit(client.create_empty_handle(), contrib.shape(), DType::F32);
+    let desc = CustomOpIr::new("contribution_bind", &[], &[out_ir]);
+    let [out] = client
+        .register(
+            StreamId::current(),
+            OperationIr::Custom(desc.clone()),
+            BindOp { desc, contrib },
+        )
+        .outputs();
+    crate::burn_glue::wrap_wgpu_float(out)
+}
