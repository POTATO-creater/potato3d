+/// Per-splat render-loss contribution for one view: how much the L1 loss
+/// would grow if the splat were removed (DeG, Yan et al. 2026, §3.3 and
+/// supp. H). Positive = the splat helps this view; negative = removing it
+/// lowers the loss (floaters, ghosts that only exist to fit an inconsistent
+/// view). Exact for L1, no linearisation: removing splat `i` scales
+/// everything behind it, background included, by `1/(1-α_i)`.
+///
+/// Same tile walk as [`rasterize_backwards_kernel`] (forward-replay order,
+/// `pix_state` = colour still to come), so each thread sees its splat's
+/// transmittance and back colour per pixel. Output is dense, indexed by
+/// global splat id.
+#[cube(launch)]
+#[allow(clippy::too_many_arguments)]
+pub fn contribution_kernel<A: AtomicAddF32>(
+    compact_gid_from_isect: &Tensor<u32>,
+    tile_offsets: &Tensor<u32>,
+    projected: &Tensor<f32>,
+    output: &Tensor<f32>,
+    gt_packed: &Tensor<u32>,
+    global_from_compact_gid: &Tensor<u32>,
+    contrib: &mut Tensor<Atomic<A::Storage>>,
+    u: RasterizeUniforms,
+    alpha_weight: f32,
+    mask_by_gt_alpha: u32,
+) {
+    let (tile_id, tile_origin_x, tile_origin_y) = tile_origin(u.tile_bw);
+    let mut pix_state = Shared::new_slice((TILE_SIZE * 4u32) as usize);
+    load_pixel_state(output, u, tile_origin_x, tile_origin_y, &mut pix_state);
+    let (range_lo, range_hi) = load_range(tile_offsets, tile_id);
+    let num_splats_in_tile = range_hi - range_lo;
+    let rounds = (num_splats_in_tile + SPLAT_BATCH - 1u32) / SPLAT_BATCH;
+
+    let mut batch_idx = 0u32;
+    while batch_idx < rounds {
+        let (compact_gid, splat, splat_active) = load_splat_for_batch(
+            compact_gid_from_isect,
+            projected,
+            range_lo,
+            num_splats_in_tile,
+            batch_idx,
+        );
+        let gain = accumulate_contribution_for_batch(
+            splat,
+            splat_active,
+            tile_origin_x,
+            tile_origin_y,
+            num_splats_in_tile,
+            batch_idx,
+            &mut pix_state,
+            output,
+            gt_packed,
+            u,
+            alpha_weight,
+            mask_by_gt_alpha,
+        );
+        if splat_active {
+            let gid = global_from_compact_gid[compact_gid as usize];
+            A::add(&contrib[gid as usize], gain);
+        }
+        batch_idx += 1u32;
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+#[cube]
+fn accumulate_contribution_for_batch(
+    splat: Splat,
+    splat_active: bool,
+    tile_origin_x: u32,
+    tile_origin_y: u32,
+    num_splats_in_tile: u32,
+    batch_idx: u32,
+    pix_state: &mut Shared<[f32]>,
+    output: &Tensor<f32>,
+    gt_packed: &Tensor<u32>,
+    u: RasterizeUniforms,
+    alpha_weight: f32,
+    mask_by_gt_alpha: u32,
+) -> f32 {
+    let conic = Sym2 {
+        c00: splat.conic_x,
+        c01: splat.conic_y,
+        c11: splat.conic_z,
+    };
+    let clamped_r = max(splat.color_r, 0.0f32);
+    let clamped_g = max(splat.color_g, 0.0f32);
+    let clamped_b = max(splat.color_b, 0.0f32);
+    let inv_255 = 1.0f32 / 255.0f32;
+
+    let num_splats_this_batch = min(SPLAT_BATCH, num_splats_in_tile - batch_idx * SPLAT_BATCH);
+    let total_iters = num_splats_this_batch + TILE_SIZE - 1u32;
+
+    let mut gain = 0.0f32;
+    let mut i = 0u32;
+    while i < total_iters {
+        let active_iter = splat_active && i >= UNIT_POS && (i - UNIT_POS) < TILE_SIZE;
+
+        if active_iter {
+            let pixel_rank = i - UNIT_POS;
+            let s = (pixel_rank * 4u32) as usize;
+            let state_x = pix_state[s];
+            let state_y = pix_state[s + 1];
+            let state_z = pix_state[s + 2];
+            let state_w = pix_state[s + 3];
+
+            if state_w > 1.0e-4f32 {
+                let pix_x = tile_origin_x + pixel_rank % TILE_WIDTH;
+                let pix_y = tile_origin_y + pixel_rank / TILE_WIDTH;
+                let dx = splat.xy_x - (pix_x as f32 + 0.5f32);
+                let dy = splat.xy_y - (pix_y as f32 + 0.5f32);
+                let sigma =
+                    0.5f32 * (conic.c00 * dx * dx + conic.c11 * dy * dy) + conic.c01 * dx * dy;
+                let alpha = min(0.999f32, splat.color_a * f32::exp(-sigma));
+                // Hard cutoff, as in the production forward.
+                if sigma >= 0.0f32 && alpha >= ALPHA_CUTOFF_MID {
+                    let next_t = state_w * (1.0f32 - alpha);
+                    if next_t <= 1.0e-4f32 {
+                        pix_state[s + 3] = 0.0f32;
+                    } else {
+                        let vis = alpha * state_w;
+                        let pix_id = pix_x + pix_y * u.img_w;
+                        let pix_base = (pix_id * 4u32) as usize;
+                        let final_a = output[pix_base + 3];
+                        let t_final = 1.0f32 - final_a;
+
+                        let behind_x = state_x - vis * clamped_r;
+                        let behind_y = state_y - vis * clamped_g;
+                        let behind_z = state_z - vis * clamped_b;
+                        // Without the splat: its own colour leaves, what is
+                        // behind it (bg too) gains a factor 1/(1-α).
+                        let k = alpha / (1.0f32 - alpha);
+                        let d_x = (behind_x + t_final * u.bg_r) * k - vis * clamped_r;
+                        let d_y = (behind_y + t_final * u.bg_g) * k - vis * clamped_g;
+                        let d_z = (behind_z + t_final * u.bg_b) * k - vis * clamped_b;
+                        let d_a = -t_final * k;
+
+                        // GT is premultiplied; composite it over the same bg
+                        // as the loss (a no-op for opaque views or zero bg).
+                        let gt = gt_packed[pix_id as usize];
+                        let gt_a = f32::cast_from(gt >> 24u32) * inv_255;
+                        let gt_r = f32::cast_from(gt & 0xffu32) * inv_255 + (1.0f32 - gt_a) * u.bg_r;
+                        let gt_g =
+                            f32::cast_from((gt >> 8u32) & 0xffu32) * inv_255 + (1.0f32 - gt_a) * u.bg_g;
+                        let gt_b = f32::cast_from((gt >> 16u32) & 0xffu32) * inv_255
+                            + (1.0f32 - gt_a) * u.bg_b;
+
+                        let r_x = output[pix_base] - gt_r;
+                        let r_y = output[pix_base + 1] - gt_g;
+                        let r_z = output[pix_base + 2] - gt_b;
+                        let r_a = final_a - gt_a;
+                        let gain_rgb = (f32::abs(r_x + d_x) - f32::abs(r_x)
+                            + f32::abs(r_y + d_y)
+                            - f32::abs(r_y)
+                            + f32::abs(r_z + d_z)
+                            - f32::abs(r_z))
+                            / 3.0f32;
+                        let gain_a = f32::abs(r_a + d_a) - f32::abs(r_a);
+                        let w = select(mask_by_gt_alpha == 1u32, gt_a, 1.0f32);
+                        gain += w * gain_rgb + alpha_weight * gain_a;
+
+                        pix_state[s] = behind_x;
+                        pix_state[s + 1] = behind_y;
+                        pix_state[s + 2] = behind_z;
+                        pix_state[s + 3] = next_t;
+                    }
+                }
+            }
+        }
+
+        sync_cube();
+        i += 1u32;
+    }
+    gain
+}
