+
+/// Run the static constructors (cubecl's `inventory` registrations) once.
+/// Referencing `__wasm_call_ctors` makes wasm-ld link a "reactor": otherwise
+/// it treats the cdylib as a "command" and wraps every export (even
+/// malloc/free) to re-run all of them on each JS→wasm call — thousands of
+/// constructors per WebGPU callback, ~50x slower training.
+fn run_static_constructors() {
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    // SAFETY: called once, before anything reads the inventory registries.
+    ONCE.call_once(|| unsafe { __wasm_call_ctors() });
+}
+
+/// Autotune at `Full`: burn-cubecl then registers no roofline bounds. At the
+/// other levels the bounds measure peak throughput with a blocking device
+/// sync (`cubecl_std::throughput`), which panics on wasm on the first reduce.
+/// `try_set` keeps a config the host may already have installed.
+fn configure_cubecl() {
+    use burn::cubecl::config::{CubeClRuntimeConfig, RuntimeConfig, autotune::AutotuneLevel};
+    let mut config = CubeClRuntimeConfig::default();
+    config.autotune.level = AutotuneLevel::Full;
+    let _ = CubeClRuntimeConfig::try_set(config);
+}
+
 fn js_err_str(s: &str) -> JsValue {
     JsValue::from_str(s)
