# Headers for the web version on Cloudflare Workers (wrangler.jsonc). Read at
# deploy time and never served; the service worker also leaves it out of the cache.
#
# `Referrer-Policy: same-origin` doesn't send the Referer to other origins:
# Hugging Face answers 404 (no CORS) when the Referer is a *.workers.dev, and
# the RMBG model download would die with "Failed to fetch". segment.ts also
# asks for `no-referrer` on its own fetch.
/*
  Referrer-Policy: same-origin

# Files under /assets have a hash in their name: they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Browsers already bypass the HTTP cache when checking for a new service worker,
# but proxies along the way don't know that.
/sw.js
  Cache-Control: no-cache
