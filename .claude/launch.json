{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "web:dev"
      ],
      "env": {
        "WEB_FS_ANY": "1"
      },
      "port": 1440
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "preview",
        "--config",
        "web/vite.config.ts",
        "--port",
        "1450",
        "--strictPort"
      ],
      "port": 1450
    },
    {
      "name": "web-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--test-scheduled",
        "--var",
        "SHARE_ORIGINS:http://localhost:1440",
        "--var",
        "SHARE_ADMIN_TOKEN:dev-share-key"
      ],
      "port": 8787
    },
    {
      "name": "web-bench",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "--config",
        "web/vite.config.ts",
        "--port",
        "1441",
        "--strictPort"
      ],
      "env": {
        "WEB_FS_ANY": "1"
      },
      "port": 1441
    },
    {
      "name": "comfy-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/comfy-mock.mjs",
        "--port",
        "8188"
      ],
      "port": 8188
    }
  ]
}
