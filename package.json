{
  "name": "gausify-orbit",
  "private": true,
  "version": "0.5.0",
  "license": "MIT",
  "repository": "github:obraia/gausify-orbit",
  "type": "module",
  "scripts": {
    "setup:tools": "node scripts/setup-tools.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dev:mock": "VITE_MOCK=1 vite --port 1430 --strictPort",
    "web:wasm": "node scripts/build-brush-web.mjs",
    "brush:native": "node scripts/build-brush-web.mjs --native",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:deploy": "pnpm web:build && wrangler deploy",
    "test:web": "node --test web/src/*/*.test.ts src/lib/*.test.ts src/lib/*/*.test.ts worker/*.test.ts"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@techstark/opencv-js": "4.12.0-release.1",
    "mediabunny": "1.60.0",
    "meshoptimizer": "1.3.0",
    "onnxruntime-web": "1.30.0",
    "playcanvas": "2.23.2",
    "qrcode-generator": "2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1",
    "xatlas-wasm": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.186.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.0.2",
    "@webgpu/types": "^0.1.74",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.20.0"
}
