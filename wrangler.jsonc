{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gausify-orbit",
  "compatibility_date": "2026-10-10",

  // The web version runs in the browser: frames, masking, poses, training and
  // export use WebGPU. The Worker (worker/index.ts) only handles share links
  // (/api/share, /s/<id>), stored in R2.
  "main": "worker/index.ts",

  // Assets from `pnpm web:build` (dist-web/) are served without waking the
  // Worker (static assets are free), except on the `run_worker_first` paths.
  // `single-page-application` answers any other unknown path with `index.html`,
  // including /assets/* files that no longer exist (see web/src/sw.template.js).
  // Workers limit: 25 MiB per file (see web/ort-wasm-plugin.ts).
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"]
  },

  // Created once with `wrangler r2 bucket create gausify-orbit-shares` (see
  // README). If wrangler offers to add the binding, decline: it is already
  // here as SHARES.
  "r2_buckets": [{ "binding": "SHARES", "bucket_name": "gausify-orbit-shares" }],

  "vars": {
    // Lifetime of each share link.
    "SHARE_TTL_HOURS": "6",
    // Largest accepted file; Cloudflare rejects bodies over 100 MB.
    "SHARE_MAX_MB": "95",
    // Extra CORS origins (the desktop app is already allowed in code).
    "SHARE_ORIGINS": ""
  },

  // Uploads per IP: 10 per minute. `namespace_id` only needs to be unique in the account.
  "ratelimits": [{ "name": "SHARE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],

  // Deletes expired links (the Worker already treats them as missing right away).
  "triggers": { "crons": ["*/30 * * * *"] },

  // Without `routes`, the address is `gausify-orbit.<subdomain>.workers.dev`. For a
  // custom domain: "routes": [{ "pattern": "example.com", "custom_domain": true }]
  "workers_dev": true
}
